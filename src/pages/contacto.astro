
---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contacto | Tueste Norte">
  <section class="contact-hero">
    <p class="eyebrow">Estamos aquí para ayudarte</p>
    <h1>Hablemos de café.</h1>
    <p>
      ¿Tienes alguna pregunta sobre nuestros cafés? Estaremos encantados de escucharte.
    </p>
  </section>

  <section class="contact-section">
    <div class="contact-content">
      <div class="contact-info">
        <h2>Contacta con Tueste Norte</h2>
        <p>
          Si quieres conocer mejor nuestros orígenes, los perfiles de tueste
          o necesitas información sobre nuestros productos, puedes escribirnos.
        </p>

        <div class="contact-detail">
          <span>☕</span>
          <div>
            <h3>Pasión por el café</h3>
            <p>Te ayudamos a descubrir tu próximo café favorito.</p>
          </div>
        </div>

        <div class="contact-detail">
          <span>🌱</span>
          <div>
            <h3>Conoce nuestros orígenes</h3>
            <p>Descubre los matices de cada variedad de nuestra selección.</p>
          </div>
        </div>
      </div>

      <form class="contact-form">
        <label for="nombre">Nombre</label>
        <input id="nombre" name="nombre" type="text" placeholder="Tu nombre" required />

        <label for="email">Correo electrónico</label>
        <input id="email" name="email" type="email" placeholder="tu@email.com" required />

        <label for="asunto">Asunto</label>
        <input id="asunto" name="asunto" type="text" placeholder="¿En qué podemos ayudarte?" required />

        <label for="mensaje">Mensaje</label>
        <textarea id="mensaje" name="mensaje" rows="5" placeholder="Escribe tu mensaje..." required></textarea>

        <button type="button" disabled>Enviar mensaje próximamente</button>
        <p class="form-note">
          Este formulario es una demostración visual y todavía no envía mensajes.
        </p>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero {
    padding: 72px 24px;
    background: #78350f;
    color: white;
    text-align: center;
  }

  .eyebrow {
    margin-bottom: 16px;
    color: #fcd34d;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .contact-hero h1 {
    font-size: clamp(36px, 5vw, 54px);
    font-weight: 700;
  }

  .contact-hero > p:last-child {
    max-width: 650px;
    margin: 18px auto 0;
    color: #fef3c7;
    line-height: 1.8;
  }

  .contact-section {
    padding: 64px 24px 80px;
    background: #fafaf9;
  }

  .contact-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .contact-info h2 {
    margin-bottom: 16px;
    color: #292524;
    font-size: 30px;
    font-weight: 700;
  }

  .contact-info > p,
  .contact-detail p {
    color: #57534e;
    line-height: 1.8;
  }

  .contact-detail {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-top: 28px;
  }

  .contact-detail > span {
    font-size: 28px;
  }

  .contact-detail h3 {
    margin-bottom: 6px;
    color: #78350f;
    font-weight: 700;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px;
    border: 1px solid #e7e5e4;
    border-radius: 18px;
    background: white;
  }

  .contact-form label {
    margin-top: 8px;
    color: #44403c;
    font-size: 14px;
    font-weight: 600;
  }

  .contact-form input,
  .contact-form textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #d6d3d1;
    border-radius: 9px;
    background: white;
    color: #292524;
    font: inherit;
  }

  .contact-form input:focus,
  .contact-form textarea:focus {
    outline: 2px solid #d97706;
    outline-offset: 1px;
  }

  .contact-form textarea {
    resize: vertical;
  }

  .contact-form button {
    margin-top: 12px;
    padding: 14px;
    border: 0;
    border-radius: 999px;
    background: #78350f;
    color: white;
    font: inherit;
    font-weight: 600;
    opacity: 0.65;
    cursor: not-allowed;
  }

  .form-note {
    color: #78716c;
    font-size: 12px;
    line-height: 1.6;
  }

  @media (min-width: 768px) {
    .contact-content {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
</style>
