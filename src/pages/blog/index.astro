
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articulos = await getCollection('blog');

articulos.sort((a, b) => {
  return b.data.fecha.getTime() - a.data.fecha.getTime();
});
---

<BaseLayout title="Blog | Tueste Norte">
  <section class="mx-auto max-w-6xl px-6 py-16 md:py-20">
    <p class="mb-3 text-sm font-bold uppercase tracking-widest text-amber-800">
      Nuestro blog
    </p>

    <h1 class="text-4xl font-bold text-stone-900 md:text-5xl">
      Recetas y métodos de preparación
    </h1>

    <p class="mt-4 max-w-2xl text-lg leading-8 text-stone-600">
      Aprende a preparar café en casa y descubre nuevas formas de disfrutar
      los aromas y matices de cada origen.
    </p>

    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {articulos.map((articulo) => (
        <article class="flex flex-col rounded-2xl border border-stone-200 bg-white p-6">
          <time
            datetime={articulo.data.fecha.toISOString()}
            class="text-sm text-stone-500"
          >
            {articulo.data.fecha.toLocaleDateString('es-ES')}
          </time>

          <h2 class="mt-4 text-2xl font-bold text-amber-900">
            {articulo.data.titulo}
          </h2>

          <p class="mt-3 flex-1 leading-7 text-stone-600">
            {articulo.data.descripcion}
          </p>

          <a
            href={`/blog/${articulo.id}/`}
            class="mt-6 inline-flex font-semibold text-amber-900 hover:text-amber-700"
          >
            Leer artículo →
          </a>
        </article>
      ))}
    </div>

    {articulos.length === 0 && (
      <p class="mt-10 rounded-xl bg-stone-100 p-6 text-stone-600">
        Próximamente publicaremos nuestros primeros artículos.
      </p>
    )}
  </section>
</BaseLayout>
