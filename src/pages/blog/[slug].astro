
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntrada } from '../../lib/wp';

export const prerender = false;

const slug = Astro.params.slug;
const articulo = slug ? await getEntrada(slug) : undefined;

const fecha = articulo
  ? new Date(articulo.fecha).toLocaleDateString('es-ES', {
      day: 'numeric',
      month: 'long',
      year: 'numeric'
    })
  : '';
---

{articulo ? (
  <BaseLayout title={`${articulo.titulo} | Tueste Norte`}>
    <main class="blog-detail">
      <a href="/blog" class="back-link">← Volver al blog</a>

      <article>
        {articulo.imagen && (
          <img
            class="blog-image"
            src={articulo.imagen}
            alt={articulo.textoAlternativo || articulo.titulo}
          />
        )}

        <p class="blog-date">{fecha}</p>

        <h1>{articulo.titulo}</h1>

        <p class="blog-excerpt">{articulo.descripcion}</p>

        <div class="blog-content" set:html={articulo.contenido} />
      </article>
    </main>
  </BaseLayout>
) : (
  <BaseLayout title="Artículo no encontrado | Tueste Norte">
    <main class="not-found">
      <h1>Artículo no encontrado</h1>
      <a href="/blog">Volver al blog</a>
    </main>
  </BaseLayout>
)}

<style>
  .blog-detail {
    max-width: 900px;
    margin: 0 auto;
    padding: 48px 24px 80px;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 32px;
    color: #78350f;
    font-weight: 600;
    text-decoration: none;
  }

  .blog-image {
    display: block;
    width: 100%;
    max-height: 450px;
    margin-bottom: 32px;
    border-radius: 18px;
    object-fit: cover;
  }

  .blog-date {
    color: #92400e;
    font-size: 14px;
  }

  h1 {
    margin: 12px 0 20px;
    color: #292524;
    font-size: clamp(32px, 5vw, 46px);
    line-height: 1.2;
  }

  .blog-excerpt {
    margin-bottom: 32px;
    color: #57534e;
    font-size: 18px;
    line-height: 1.7;
  }

  .blog-content {
    color: #57534e;
    line-height: 1.8;
  }

  .not-found {
    padding: 80px 24px;
    text-align: center;
  }
</style>
