
---
import Layout from '../layouts/Layout.astro';
import Badge from '../components/Badge.astro';
---

<Layout>
  <main class="min-h-screen bg-stone-50 p-8 md:p-12">
    <section class="mx-auto max-w-6xl">
      <h1 class="mb-6 text-3xl font-bold text-stone-900">
        Pruebas de etiquetas
      </h1>

      <div class="flex flex-wrap items-center gap-4">
        <Badge texto="Tueste claro" tono="tueste" />
        <Badge texto="Origen: Etiopía" tono="origen" />
        <Badge texto="Nuevo" tono="nuevo" />
      </div>
    </section>
  </main>
</Layout>
