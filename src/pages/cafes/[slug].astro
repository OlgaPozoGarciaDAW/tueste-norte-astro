
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntrada } from '../../lib/wp';

const slug = Astro.params.slug;
const articulo = slug ? await getEntrada(slug) : undefined;
---

{articulo ? (
  <BaseLayout title={`${articulo.titulo} | Tueste Norte`}>
    <main class="article-detail">
      <a href="/blog/" class="back-link">← Volver al blog</a>

      <article>
        <p class="eyebrow">Nuestro blog</p>

        <h1>{articulo.titulo}</h1>

        <time datetime={articulo.fecha}>
          {new Date(articulo.fecha).toLocaleDateString('es-ES')}
        </time>

        {articulo.imagen && (
          <img
            class="article-image"
            src={articulo.imagen}
            alt={articulo.textoAlternativo || articulo.titulo}
          />
        )}

        <div class="article-content" set:html={articulo.contenido} />
      </article>
    </main>
  </BaseLayout>
) : (
  <BaseLayout title="Artículo no encontrado | Tueste Norte">
    <main class="not-found">
      <h1>Artículo no encontrado</h1>
      <a href="/blog/">Volver al blog</a>
    </main>
  </BaseLayout>
)}

<style>
  .article-detail {
    max-width: 900px;
    margin: 0 auto;
    padding: 48px 24px 80px;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 32px;
    color: #78350f;
    font-weight: 600;
    text-decoration: none;
  }

  .eyebrow {
    color: #92400e;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  h1 {
    margin: 16px 0;
    color: #292524;
    font-size: clamp(34px, 5vw, 48px);
    line-height: 1.2;
  }

  time {
    color: #78716c;
    font-size: 14px;
  }

  .article-image {
    display: block;
    width: 100%;
    max-height: 460px;
    margin: 32px 0;
    border-radius: 18px;
    object-fit: cover;
  }

  .article-content {
    color: #57534e;
    font-size: 17px;
    line-height: 1.9;
  }

  .not-found {
    padding: 80px 24px;
    text-align: center;
  }
</style>
