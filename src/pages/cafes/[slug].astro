
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCafe } from '../../lib/wp';

export const prerender = false;

const slug = Astro.params.slug;
const cafe = slug ? await getCafe(slug) : undefined;
---

{cafe ? (
  <BaseLayout title={`${cafe.titulo} | Tueste Norte`}>
    <main class="cafe-detail">
      <a href="/cafes" class="back-link">← Volver a nuestros cafés</a>

      <section class="cafe-content">
        <div class="cafe-image">
          {cafe.imagen && (
            <img
              src={cafe.imagen}
              alt={cafe.textoAlternativo || `Café ${cafe.titulo}`}
            />
          )}
        </div>

        <div class="cafe-info">
          <p class="eyebrow">Café de especialidad</p>
          <h1>{cafe.titulo}</h1>
          <p class="origin">{cafe.origen}</p>

          <div class="detail-item">
            <h2>Notas de cata</h2>
            <p>{cafe.notasDeCata}</p>
          </div>

          <div class="detail-item">
            <h2>Nivel de tueste</h2>
            <p>{cafe.nivelDeTueste}</p>
          </div>

          <p class="price">
            {cafe.precio.toFixed(2).replace('.', ',')} €
          </p>
        </div>
      </section>

      <section class="description">
        <h2>Sobre este café</h2>
        <div set:html={cafe.contenido} />
      </section>
    </main>
  </BaseLayout>
) : (
  <BaseLayout title="Café no encontrado | Tueste Norte">
    <main class="not-found">
      <h1>Café no encontrado</h1>
      <a href="/cafes">Volver al catálogo</a>
    </main>
  </BaseLayout>
)}

<style>
  .cafe-detail {
    max-width: 1100px;
    margin: 0 auto;
    padding: 48px 24px 80px;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 32px;
    color: #78350f;
    font-weight: 600;
    text-decoration: none;
  }

  .cafe-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }

  .cafe-image img {
    display: block;
    width: 100%;
    border-radius: 18px;
    object-fit: cover;
  }

  .eyebrow {
    color: #92400e;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .cafe-info h1 {
    margin: 12px 0;
    color: #292524;
    font-size: 42px;
  }

  .origin {
    margin-bottom: 32px;
    color: #92400e;
    font-weight: 600;
  }

  .detail-item {
    margin-bottom: 24px;
  }

  .detail-item h2,
  .description h2 {
    margin-bottom: 8px;
    color: #292524;
    font-size: 21px;
  }

  .detail-item p,
  .description {
    color: #57534e;
    line-height: 1.8;
  }

  .price {
    margin-top: 28px;
    color: #78350f;
    font-size: 30px;
    font-weight: 700;
  }

  .description {
    margin-top: 56px;
    padding-top: 32px;
    border-top: 1px solid #e7e5e4;
  }

  .not-found {
    padding: 80px 24px;
    text-align: center;
  }

  @media (max-width: 700px) {
    .cafe-content {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .cafe-info h1 {
      font-size: 34px;
    }
  }
</style>
